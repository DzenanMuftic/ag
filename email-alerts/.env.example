# Copy this file to `.env` and fill in your real values.
# The script auto-loads `.env` from its own directory.

# --- Email (IMAP / SMTP) ---
EMAIL_IMAP_HOST=mail.privateemail.com
EMAIL_USER=info@asistentica.online
EMAIL_PASSWORD=your_email_password
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465

# --- Telegram ---
TG_TOKEN=your_telegram_bot_token
TG_CHAT=your_telegram_chat_id

# --- DeepSeek ---
DEEPSEEK_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-chat

# Set to "true" to actually email the AI reply to the sender (default false = draft only)
AUTO_SEND=false
